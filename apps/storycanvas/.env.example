# StoryCanvas model role mapping (API keys stay in the environment)
MODELS_CONFIG_PATH=config/models.json
MODELS_AUTO_SEED=1

# OpenAI-compatible LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# OpenAI image generation (gpt-image-2)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Volcengine Seedream / Seedance
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_API_KEY=
SEEDANCE_VIDEO_MODEL=dreamina-seedance-2-0-260128
SEEDANCE_GENERATE_AUDIO=false

# Independent BytePlus TTS is a separate entitlement from ModelArk video.
# Keep it disabled until BYTEPLUS_TTS_PROTOCOL names a reviewed transport.
# Protocol-specific credential names are defined by that reviewed transport;
# StoryCanvas intentionally does not guess an endpoint or auth contract.
BYTEPLUS_TTS_ENABLED=false
BYTEPLUS_TTS_PROTOCOL=

# BytePlus overseas ModelArk virtual character asset library (SigV4).
# Keep real values only in the ignored local .env file.
ARK_ASSET_ACCESS_KEY=
ARK_ASSET_SECRET_KEY=
ARK_ASSET_GROUP_ID=
ARK_ASSET_HOST=ark.ap-southeast-1.byteplusapi.com
ARK_ASSET_REGION=ap-southeast-1
ARK_ASSET_SERVICE=ark
ARK_ASSET_VERSION=2024-01-01

# Optional overseas TOS target for registering Image 2 output in BytePlus.
# When omitted, StoryCanvas tries to infer these values from an existing Active asset URL.
ARK_ASSET_TOS_BUCKET=
ARK_ASSET_TOS_ENDPOINT=tos-ap-southeast-1.volces.com
ARK_ASSET_TOS_REGION=ap-southeast-1
ARK_ASSET_TOS_PREFIX=

# Toonflow -> FireRed-OpenStoryline health adapter
OPENSTORYLINE_BASE_URL=http://127.0.0.1:7860
OPENSTORYLINE_MCP_URL=http://127.0.0.1:8001/mcp
OPENSTORYLINE_TIMEOUT_MS=2000
